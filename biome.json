{
	"html": {
		"parser": {
			"vue": true
		}
	},
	"linter": {
		"rules": {
			"a11y": {
				"useHtmlLang": "off"
			},
			"correctness": {
				"noUnknownFunction": {
					"level": "error",
					"options": {
						"ignore": ["random"]
					}
				}
			},
			"complexity": {
				"noImportantStyles": "error"
			}
		}
	},
	"overrides": [
		{
			"includes": ["css/main.css"],
			"linter": {
				"rules": {
					"complexity": {
						"noImportantStyles": "off"
					}
				}
			}
		}
	]
}
